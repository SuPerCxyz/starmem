# Runtime
STARMEM_ENV=development
STARMEM_DATABASE_URL=postgresql+psycopg://starmem:starmem@postgres:5432/starmem
STARMEM_REDIS_URL=redis://redis:6379/0
STARMEM_SESSION_SECRET=change-this-to-a-long-random-value
STARMEM_COOKIE_SECURE=false
STARMEM_CORS_ORIGINS=http://localhost:18780,http://localhost:5173
STARMEM_RATE_LIMIT_PER_MINUTE=120
STARMEM_API_PORT=18000
STARMEM_WEB_PORT=18780

# Local UI typography validation targets.
TABLER_REFERENCE_URL=http://localhost:3000
STARMEM_URL=http://localhost:18780

# Bootstrap administrator. The password is read only during first initialization.
STARMEM_ADMIN_EMAIL=admin@starmem.local
STARMEM_ADMIN_PASSWORD=change-this-password

# OpenAI-compatible Chat provider. Supply the API key only in your untracked .env.
STARMEM_CHAT_BASE_URL=https://llm.soocoo.xyz/v1
STARMEM_CHAT_MODEL=qwen35-4b
STARMEM_CHAT_API_KEY=
STARMEM_CHAT_ENABLE_THINKING=false
STARMEM_CHAT_TIMEOUT_SECONDS=45
STARMEM_CHAT_MAX_RETRIES=2

# Local attachment/import processing.
STARMEM_STORAGE_PATH=/var/lib/starmem/attachments
STARMEM_MAX_UPLOAD_BYTES=20000000
STARMEM_MAX_URL_BYTES=20000000
STARMEM_MAX_PDF_PAGES=500
STARMEM_URL_TIMEOUT_SECONDS=20
STARMEM_URL_MAX_REDIRECTS=3
STARMEM_OCR_ENABLED=true
STARMEM_OCR_LANG=eng+chi_sim
STARMEM_OCR_TIMEOUT_SECONDS=30

# Semantic search is served by a separate local embedding provider.
STARMEM_EMBEDDING_PROVIDER=fastembed
STARMEM_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
STARMEM_EMBEDDING_DIMENSIONS=512
STARMEM_HYBRID_KEYWORD_WEIGHT=0.55
STARMEM_HYBRID_SEMANTIC_WEIGHT=0.45
# 纯语义候选的最低余弦相似度；低于该值且无关键词命中的结果会被丢弃
STARMEM_SEMANTIC_MIN_SIMILARITY=0.35

# PostgreSQL container only
POSTGRES_DB=starmem
POSTGRES_USER=starmem
POSTGRES_PASSWORD=starmem
