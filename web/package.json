{
  "name": "starmem-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "ui:validate-tabler-typography": "node ../scripts/ui/validate-tabler-typography.mjs",
    "ui:audit-page-typography": "node ../scripts/ui/audit-page-typography.mjs",
    "ui:validate-tabler": "npm run ui:validate-tabler-typography && npm run ui:audit-page-typography",
    "ui:verify-fonts": "node ../scripts/ui/verify-tabler-rendered-fonts.mjs",
    "ui:audit-fonts": "node ../scripts/ui/audit-page-typography.mjs",
    "ui:verify-tabler-fonts": "npm run ui:verify-fonts && npm run ui:audit-fonts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.62.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
